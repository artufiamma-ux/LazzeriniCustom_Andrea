namespace Lazzerini;

using Microsoft.Purchases.Document;

report 50201 "XV Barcode Fattura Acquisto"
{
    UsageCategory = ReportsAndAnalysis;
    ApplicationArea = All;

    DefaultLayout = RDLC;
    RDLCLayout = './ReportLayouts/BarcodeFatAcquisto.rdl';

    Caption = 'Barcode Fattura Acquisto';
    WordMergeDataItem = Header;

    dataset
    {
        dataitem(Header; "Purchase Header")
        {
            // Filtra solo Fatture Acquisto (se vuoi includere anche Ordini rimuovi il filtro)
            DataItemTableView = where("Document Type" = const(Invoice));

            // Campi di business
            column(DocumentType; "Document Type") { }
            column(No_; "No.") { }
            column(VendorNo; "Buy-from Vendor No.") { }
            column(VendorName; "Buy-from Vendor Name") { }
            column(PostingDate; "Posting Date") { }

            // Output barcode – font-based
            column(BarcodeText_Code128; EncodedBarcodeText) { }

            // Output barcode – immagine Base64
            column(BarcodeImage_Base64; BarcodeImageBase64) { }

            // Scelta utente (utile in RDLC per mostrare una sezione o l’altra)
            column(OutputAsImageFlag; OutputAsImage) { }

            trigger OnAfterGetRecord()
            var
                BarcodeProvider: Codeunit "Barcode Font Provider";
                BarcodeMgmt: Codeunit "Barcode Management";
                TempBlob: Codeunit "Temp Blob";
                OutStr: OutStream;
            begin
                Clear(EncodedBarcodeText);
                Clear(BarcodeImageBase64);

                if OutputAsImage then begin
                    // ----- Modalità IMMAGINE -----
                    TempBlob.CreateOutStream(OutStr);
                    // Genera PNG stream con Code128
                    BarcodeMgmt.EncodeBarcode("No.", Enum::"Barcode Symbology"::Code128, OutStr);

                    // Converti lo stream in Base64 per RDLC (immagine esterna)
                    BarcodeImageBase64 := TempBlob.ToBase64String();
                end else begin
                    // ----- Modalità FONT-BASED -----
                    // Restituisce la stringa da stampare con font Code128
                    EncodedBarcodeText := BarcodeProvider.EncodeFont("No.", Enum::"Barcode Symbology"::Code128);
                end;
            end;
        }
    }

    requestpage
    {
        layout
        {
            area(Content)
            {
                group(Options)
                {
                    Caption = 'Opzioni';
                    field(OutputAsImage; OutputAsImage)
                    {
                        ApplicationArea = All;
                        Caption = 'Stampa come immagine (PNG)';
                        ToolTip = 'Se attivo, il barcode viene emesso come immagine PNG nel report. Se disattivo, viene emessa una stringa da renderizzare con un font Code128.';
                    }
                }
            }
        }
    }

    var
        OutputAsImage: Boolean;
        EncodedBarcodeText: Text; // per modalità font-based
        BarcodeImageBase64: Text; // per modalità immagine
}