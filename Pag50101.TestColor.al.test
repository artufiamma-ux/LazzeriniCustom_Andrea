namespace Xview.Custom.Lazzerini;

using Microsoft.Inventory.Item;

pageextension 50101 "ItemColorExt" extends "Item List"
{
    layout
    {
        // Aggiungiamo il pallino prima della descrizione
        addbefore(Description)
        {
            field(AlphaColorCircle; GetAlphaColorCircle())
            {
                Caption = 'Info';
                ApplicationArea = All;
                ToolTip = 'Colore basato sulla prima lettera della descrizione';
                Editable = false;
            }
        }
    }

    local procedure GetAlphaColorCircle(): Text
    var
        FirstChar: Code[1];
    begin
        if Rec.Description = '' then
            exit('⚪'); // Bianco se vuoto

        // Prendiamo la prima lettera e la rendiamo maiuscola per il confronto
        FirstChar := UpperCase(CopyStr(Rec.Description, 1, 1));

        case FirstChar of
            'A' .. 'E':
                exit('🔴'); // Rosso per A-E
            'F' .. 'L':
                exit('🔵'); // Blu per F-L
            'M' .. 'R':
                exit('🟢'); // Verde per M-R
            'S' .. 'Z':
                exit('🟡'); // Giallo per S-Z
            '0' .. '9':
                exit('⚫'); // Nero per numeri
            else
                exit('🟣'); // Viola per caratteri speciali
        end;
    end;
}