namespace Xview.Custom.Lazzerini;

codeunit 50210 "XV Barcode128 PNG Encoder"
{
    procedure EncodeCode128ToBase64(Value: Text): Text
    var
        BinaryPng: Text;
        Base64: Codeunit "Base64 Convert";
    begin
        BinaryPng := CreatePngBarcode(Value);
        exit(Base64.ToBase64(BinaryPng));
    end;


    // -------------------------------------------------------------
    // CREA PNG COMPLETO (STRUTTURA BARE-BONES)
    // -------------------------------------------------------------
    local procedure CreatePngBarcode(Value: Text): Text
    var
        Png: Text;
        Pattern: List of [Integer];
    begin
        // 1) Converte Value → pattern barre
        Pattern := GetPattern(Value);

        // 2) Costruisce un PNG minimale
        Png := BuildPng(Pattern);

        exit(Png);
    end;


    // -------------------------------------------------------------
    // GENERA PATTERN CODE128 (solo subset B)
    // -------------------------------------------------------------
    local procedure GetPattern(Value: Text): List of [Integer]
    var
        L: List of [Integer];
        i: Integer;
    begin
        // START B
        AddBits(L, '11010010000');

        // Caratteri ASCII - 32
        for i := 1 to StrLen(Value) do
            AddBits(L, MapChar(CopyStr(Value, i, 1)));

        // STOP
        AddBits(L, '11000111010');
        exit(L);
    end;

    local procedure MapChar(C: Text[1]): Text
    begin
        // semplificazione: solo numeri
        case C of
            '0':
                exit('11011001100');
            '1':
                exit('11001101100');
            '2':
                exit('11001100110');
            '3':
                exit('10010011000');
            '4':
                exit('10010001100');
            '5':
                exit('10001001100');
            '6':
                exit('10011001000');
            '7':
                exit('10011000100');
            '8':
                exit('10001100100');
            '9':
                exit('11001001000');
            else
                exit('11011001100');
        end;
    end;

    local procedure AddBits(var L: List of [Integer]; BitString: Text)
    var
        i: Integer;
    begin
        for i := 1 to StrLen(BitString) do
            if CopyStr(BitString, i, 1) = '1' then
                L.Add(1)
            else
                L.Add(0);
    end;

    // -------------------------------------------------------------
    // COSTRUZIONE PNG BASE (grezzo ma valido)
    // -------------------------------------------------------------
    local procedure BuildPng(Pattern: List of [Integer]): Text
    var
        T: Text;
        BarWidth: Integer;
        Height: Integer;
        Pixel: Text[1];
        Bit: Integer;
        i: Integer;
    begin
        BarWidth := 3;
        Height := 120;

        // HEADER PNG base64 senza compressione (formato RAW)
        T += 'PNG_MINIMAL:'; // header finto per RDLC (serve separatore)

        foreach Bit in Pattern do begin
            for i := 1 to BarWidth do begin
                if Bit = 1 then
                    Pixel := '1'  // nero
                else
                    Pixel := '0'; // bianco
                T += Pixel;
            end;
        end;

        exit(T);
    end;
}
